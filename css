:root {
  --bg-color: #ffffff;
  --text-color: #222222;
  --card-bg: #f5f5f5;
  --primary: #4f46e5;
}

[data-theme="dark"] {
  --bg-color: #121212;
  --text-color: #ffffff;
  --card-bg: #1e1e1e;
  --primary: #818cf8;
}

body {
  background: var(--bg-color);
  color: var(--text-color);
  font-family: Arial, sans-serif;
  transition: 0.3s ease;
}
